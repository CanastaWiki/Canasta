RewriteEngine On

# Close access to git repo
RedirectMatch 404 /\.git

# Disable directory indexing
Options -Indexes

# VisualEditor support
RewriteRule ^/?w/rest.php/ - [L]

# Allow img_auth.php to handle authenticated image requests
RewriteRule ^/?w/img_auth.php/ - [L]

# Artificial robots.txt and sitemap.xml files
RewriteRule ^/?robots\.txt$ robots.php [L]
RewriteRule ^/?sitemap\.xml$ sitemap.php [L]

# Redirect / to Main Page
RewriteRule ^/*$ %{DOCUMENT_ROOT}/w/index.php [L]

# Wiki farm sub-path support: route /wikiid/w/load.php (etc.) to
# the real PHP entry point. Without this, sub-path wiki requests for
# load.php, api.php, etc. fall through to the catch-all and get
# served by index.php, which returns HTML instead of the expected
# resource (CSS, JSON, etc.).
RewriteRule ^/?[^/]+/w/(load|api|rest|index|img_auth)\.php(.*)$ %{DOCUMENT_ROOT}/w/$1.php$2 [L,QSA]

# see https://www.mediawiki.org/wiki/Manual:Short_URL/Apache
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-d
RewriteRule ^(.*)$ %{DOCUMENT_ROOT}/w/index.php [L]

<IfModule mod_expires.c>
    ExpiresActive on

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Video
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/mpeg "access plus 1 year"

    # Fonts
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
